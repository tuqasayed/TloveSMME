/* Avatar loading: keep the initials visible until the photo is ready. */
.avatar{position:relative}
.avatar .avatar-fallback{position:absolute;inset:0;display:grid;place-items:center;z-index:0}
.avatar>img{position:absolute;inset:0;z-index:1;width:100%;height:100%;object-fit:cover;border-radius:inherit}

/* Online presence indicators */
.contact-avatar-wrap{position:relative;display:inline-flex;flex:0 0 39px;width:39px;height:39px}
.contact-avatar-wrap>.avatar{width:39px;height:39px;flex:0 0 39px}
.presence-dot{display:none;position:absolute;left:-2px;bottom:-2px;width:12px;height:12px;border:2px solid #fff;border-radius:50%;background:#22c55e;box-shadow:0 1px 5px #0003;z-index:3}
.presence-dot.is-online{display:block;animation:presencePulse 2s ease-in-out infinite}
.contact-details{min-width:0;flex:1}
.contact-status{display:block;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-header #chatAvatar{position:relative}
.chat-header.is-online #chatAvatar::after{content:"";position:absolute;left:-2px;bottom:-2px;width:14px;height:14px;border:2px solid #fff;border-radius:50%;background:#22c55e;box-shadow:0 1px 6px #0004;z-index:4;animation:presencePulse 2s ease-in-out infinite}
@keyframes presencePulse{50%{box-shadow:0 0 0 4px #22c55e22,0 1px 6px #0004}}
.dark-mode .presence-dot,.dark-mode .chat-header.is-online #chatAvatar::after{border-color:#22202e}


/* Sidebar contacts: avatar on the LEFT, text on the RIGHT. */
.contact {
  direction: ltr;
  flex-direction: row;
  flex-wrap: nowrap;
  justify-content: flex-start;
  text-align: right;
}
.contact > div:nth-child(2) {
  direction: rtl;
  flex: 1 1 auto;
  width: auto;
  min-width: 0;
  text-align: right;
}
.contact strong, .contact small {
  text-align: right;
  overflow-wrap: anywhere;
}
@media (max-width: 760px) {
  .contact {
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-start;
    gap: 5px;
    padding: 7px 2px;
  }
  .contact > div:nth-child(2) {
    width: auto;
    flex: 1 1 auto;
    text-align: right;
  }
  .contact .avatar, .contact .group-avatar {
    flex: 0 0 31px;
  }
}

/* Incoming message avatars on the LEFT; bubble content remains RTL/right-aligned. */
.message-row.theirs { direction: ltr; }
.message-row.theirs .message { direction: rtl; text-align: right; }

/* Group header only: group avatar RIGHT, name/details LEFT. */
.chat-header { direction: ltr; }
.chat-header .header-deco { order: 1; margin-left: 0; margin-right: auto; }
.chat-header #pinnedToggle { order: 2; }
.chat-header .chat-person { order: 3; direction: rtl; text-align: right; }
.chat-header #chatAvatar { order: 4; flex: 0 0 auto; }


