/* Smooth show/hide handle for the conversations sidebar. */
.chat-view {
  --sidebar-open-width: 280px;
  position: relative;
  transition: grid-template-columns .38s cubic-bezier(.22,.8,.25,1);
}
.sidebar {
  transition: padding .32s ease, opacity .24s ease, border-color .32s ease;
}
.sidebar-toggle {
  position: absolute;
  z-index: 25;
  top: 50%;
  left: var(--sidebar-open-width);
  transform: translate(-50%, -50%);
  width: 25px;
  height: 64px;
  padding: 0;
  border: 1px solid #d8b4e8a8;
  border-radius: 14px;
  background: linear-gradient(180deg, #292638f2, #42314bf2);
  color: #f2b4dc;
  font: 26px/1 Tahoma, Arial, sans-serif;
  box-shadow: 0 3px 16px #0004, 0 0 12px #d98acb38;
  cursor: pointer;
  display: grid;
  place-items: center;
  transition: left .38s cubic-bezier(.22,.8,.25,1), background .2s ease, color .2s ease;
  touch-action: manipulation;
}
.sidebar-toggle:active { transform: translate(-50%, -50%) scale(.94); }
.sidebar-toggle:hover { background: #594365; color: #fff; }
.chat-view.sidebar-collapsed { grid-template-columns: 0 minmax(0, 1fr) !important; }
.chat-view.sidebar-collapsed .sidebar {
  width: 0 !important; min-width: 0 !important; padding: 0 !important;
  border: 0 !important; opacity: 0; overflow: hidden !important;
  visibility: hidden; pointer-events: none;
}
.chat-view.sidebar-collapsed .sidebar-toggle { left: 0; }
.chat-view.sidebar-collapsed .sidebar-toggle::before { content: none; }
@media (max-width: 760px) {
  .chat-view { --sidebar-open-width: 124px; }
  .sidebar-toggle { width: 22px; height: 58px; border-radius: 12px; font-size: 23px; }
}
@media (prefers-reduced-motion: reduce) {
  .chat-view, .sidebar, .sidebar-toggle { transition: none !important; }
}

/* iOS-inspired compact message action menu. */
.message-tools{position:relative;display:flex;align-items:center;justify-content:flex-start;margin-top:6px;opacity:1;min-height:30px}
.message-more{width:34px;height:30px;border:1px solid #ffffff18!important;border-radius:12px!important;background:#ffffff12!important;color:var(--ink)!important;font-size:22px!important;line-height:1!important;letter-spacing:1px;padding:0 0 7px!important;display:grid;place-items:center;box-shadow:0 3px 10px #00000012;transition:transform .18s ease,background .18s ease}
.message-more:active{transform:scale(.92)}
.message-actions-menu{position:absolute;z-index:30;left:0;bottom:calc(100% + 7px);display:flex;align-items:center;gap:5px;padding:7px;border:1px solid #ffffff25;border-radius:17px;background:rgba(39,37,53,.94);backdrop-filter:blur(18px) saturate(1.35);-webkit-backdrop-filter:blur(18px) saturate(1.35);box-shadow:0 12px 32px #0005;transform-origin:bottom left;animation:messageMenuIn .2s cubic-bezier(.2,.8,.2,1) both}
.message-actions-menu[hidden]{display:none!important}
.message-actions-menu button{display:flex;align-items:center;gap:5px;white-space:nowrap;border:0;border-radius:11px;background:#ffffff12;color:#f6f0ff;padding:8px 10px;font-size:12px;cursor:pointer;transition:background .16s ease,transform .16s ease}
.message-actions-menu button:active{transform:scale(.94);background:#ffffff28}
.message-actions-menu button span{font-size:10px}
@keyframes messageMenuIn{from{opacity:0;transform:translateY(7px) scale(.92)}to{opacity:1;transform:translateY(0) scale(1)}}

/* WhatsApp-like pinned message strip with tappable message previews. */
.pinned-bar{display:flex;align-items:center;gap:9px;overflow-x:auto;white-space:normal;padding:8px 12px;scrollbar-width:none}
.pinned-bar::-webkit-scrollbar{display:none}
.pinned-heading{flex:0 0 auto;font-weight:800;font-size:11px}
.pinned-items{display:flex;align-items:stretch;gap:7px;min-width:0}
.pinned-item{display:flex;flex-direction:column;align-items:flex-start;gap:2px;min-width:130px;max-width:190px;padding:6px 9px;border:1px solid #d9c58e66;border-radius:10px;background:#ffffff12;color:inherit;text-align:right;cursor:pointer}
.pinned-item b{font-size:10px}
.pinned-item span{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px;opacity:.85}
.pinned-item:active{transform:scale(.97)}
.reply-quote{width:100%;border:0;border-right:3px solid #bd9fe9;text-align:right;cursor:pointer;color:inherit}
.reply-quote:disabled{cursor:default}
.reply-quote:not(:disabled):active{filter:brightness(1.12)}
.message-jump-highlight{animation:messageJumpGlow 2s ease-out both;scroll-margin:24px}
@keyframes messageJumpGlow{0%,18%{box-shadow:0 0 0 3px #f5c86b,0 0 28px #f5c86bcc;filter:brightness(1.22)}100%{box-shadow:0 5px 18px #0003;filter:none}}
.dark-mode .message-more{background:#ffffff10!important;color:#f5f1ff!important}
@media(max-width:700px){
 .message-actions-menu{gap:4px;padding:6px;border-radius:15px;max-width:min(82vw,340px)}
 .message-actions-menu button{padding:7px 8px;font-size:11px}
 .message-actions-menu button span{font-size:9px}
 .pinned-bar{padding:7px 9px}
 .pinned-item{min-width:115px;max-width:155px}
}
@media(prefers-reduced-motion:reduce){.message-actions-menu,.message-jump-highlight{animation:none!important;scroll-behavior:auto!important}}


/* Mobile message sizing only; preserve the original action-menu appearance. */
@media (max-width: 760px) {
  .message-row { width:100%; max-width:100%; gap:6px; }
  .message-row .message {
    flex: 0 1 auto;
    width: auto;
    min-width: min(165px, calc(100% - 36px));
    max-width: calc(100% - 36px) !important;
    padding: 11px 12px 9px;
    box-sizing: border-box;
  }
  .message p { font-size: 13px; line-height: 1.65; }
  .message-tools { justify-content:center; }
  /* Same original horizontal iOS-style menu, centered above its message. */
  .message-actions-menu {
    left:50% !important;
    right:auto !important;
    transform-origin:bottom center !important;
    animation:messageMenuCenteredIn .2s cubic-bezier(.2,.8,.2,1) both !important;
  }
}
@keyframes messageMenuCenteredIn {
  from { opacity:0; transform:translate(-50%, 7px) scale(.92); }
  to { opacity:1; transform:translate(-50%, 0) scale(1); }
}
/* Keep the no-jank instant sidebar toggle. */
.chat-view, .sidebar, .sidebar-toggle { transition:none !important; animation:none !important; }
.sidebar-toggle:active { transform:translate(-50%, -50%); }
@media (max-width:760px) {
  .chat-view, .sidebar, .sidebar-toggle { transition:none !important; animation:none !important; }
}
