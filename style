order-color .2s,background .2s}.action-card:hover,.secret-card:hover{transform:translateY(-3px);border-color:#d8b6d744;background:linear-gradient(145deg,#302338cc,#111015)}.action-card>span,.secret-card>span{font-size:27px}.action-card strong,.secret-card strong{font-size:13px}.action-card small,.secret-card small{font-size:10px;color:#9d92a2;line-height:1.7}.result-box{margin-top:16px;border:1px solid #d0a6d21c;background:#c09ac20b;border-radius:13px;padding:17px;min-height:60px;line-height:1.9;text-align:center;font-size:14px;color:#e3d5e7}.section-desc{font-size:12px;color:#a69aa9;line-height:2;margin:-8px 0 18px}.secret-counter{text-align:center;font-size:11px;color:#a99bac;margin-top:18px}.secret-counter b{color:#edc6ef;font-size:15px}.quiz-question{font-size:16px;line-height:1.9;text-align:center;color:#e9dce9;margin:4px auto 18px}.quiz-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.quiz-options button{border:1px solid #ffffff12;background:#ffffff06;border-radius:12px;padding:12px 7px;font-size:12px;cursor:pointer;transition:.2s}.quiz-options button:hover{border-color:#d6a6d5aa;background:#c69ac714}.quiz-footnote{text-align:center;color:#83798a;font-size:10px;margin:14px 0 0}.ending{text-align:center;padding-top:35px;padding-bottom:35px}.ending-heart{font-size:40px;color:#d6b3d7;animation:orbitPulse 3s infinite}.ending h2{font-size:clamp(24px,5vw,35px);line-height:1.7}.ending>p:not(.eyebrow){font-size:13px;color:#b9adbd;line-height:2;max-width:550px;margin:0 auto 22px}.final-message{margin:22px auto 0;padding:18px;border:1px solid #d8b6d733;border-radius:15px;line-height:2.1;color:#f0dff0;background:#c99ac50b;max-width:620px;animation:fadeUp .5s ease}.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:#211b26f5;border:1px solid #caa8cd44;padding:12px 17px;border-radius:999px;color:#f0e4f2;font-size:12px;z-index:50;max-width:calc(100vw - 30px);text-align:center;transitio