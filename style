/* قاموس تقى وسماء ومنة */
.dictionary-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:18px}
.dictionary-word{display:flex;flex-direction:column;gap:6px;padding:15px 16px;border:1px solid rgba(218,190,226,.14);border-radius:15px;background:linear-gradient(145deg,rgba(35,27,39,.76),rgba(13,12,17,.92));box-shadow:inset 0 1px rgba(255,255,255,.025)}
.dictionary-word strong{font-size:17px;color:#e7cde9}
.dictionary-word span{font-size:14px;line-height:1.7;color:rgba(255,255,255,.78)}
.dictionary-note{margin:18px 0 0;color:rgba(255,255,255,.58);font-size:13px;line-height:1.9}
@media(max-width:420px){.dictionary-grid{gap:8px}.dictionary-word{padding:12px}.dictionary-word strong{font-size:15px}.dictionary-word span{font-size:13px}}

/* صور الذكريات: مستطيلات مناسبة للموبايل */
.memories-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:18px}
.memory-photo{margin:0;min-width:0;overflow:hidden;border:1px solid #ffffff18;border-radius:16px;background:linear-gradient(145deg,#211b25b3,#0c0b0f);padding:8px;box-shadow:0 10px 30px #0004}
.memory-photo img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:10px;background:#17131a;cursor:zoom-in;transition:transform .2s}.memory-photo img:hover{transform:scale(1.02)}
.memory-photo figcaption{text-align:center;color:#cbb8d0;font-size:12px;padding:10px 3px 4px}
@media(max-width:430px){.memories-grid{gap:9px}.memory-photo{padding:5px;border-radius:12px}.memory-photo img{border-radius:8px}.memory-photo figcaption{font-size:10px}}

/* Full-size photo viewer */
.photo-lightbox{position:fixed;inset:0;z-index:10000;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(4,3,7,.94);backdrop-filter:blur(8px)}
.photo-lightbox.hidden{display:none}
.photo-lightbox img{display:block;max-width:96vw;max-height:88vh;width:auto;height:auto;object-fit:contain;border-radius:12px;box-shadow:0 12px 60px #0009}
.close-photo{position:absolute;top:14px;right:18px;width:44px;height:44px;border:1px solid #ffffff45;border-radius:50%;background:#211b25;color:#fff;font-size:32px;line-height:1;cursor:pointer}
