/* Cinematic credits additions */

/* ── Cinematic credits / theatre curtain ── */
.side-footer{display:flex;justify-content:center;align-items:center;padding:8px 12px 14px}
.credits-trigger{width:100%;display:flex;align-items:center;justify-content:center;gap:10px;margin:0;padding:11px 14px;border:1px solid #e8d9f5;border-radius:15px;background:linear-gradient(110deg,#fff,#f8efff,#fff0f6);color:#8c6bb4;font-weight:800;font-size:12px;cursor:pointer;box-shadow:0 7px 20px #bca8f52b;transition:transform .25s,box-shadow .25s}
.credits-trigger:hover{transform:translateY(-3px);box-shadow:0 10px 26px #bca8f55c}.credits-trigger-icon,.credits-trigger-arrow{font-size:17px;color:#d99ac4;animation:creditTwinkle 1.8s ease-in-out infinite}.credits-trigger-arrow{animation-delay:.8s}
@keyframes creditTwinkle{50%{opacity:.35;transform:rotate(35deg) scale(.8)}}
.credits-modal{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;overflow:hidden;padding:10px;background:radial-gradient(ellipse at 50% 35%,#34204def,#090711f7 72%);isolation:isolate}
.credits-modal.hidden{display:none!important}
/* The curtains begin closed in the middle, then sweep fully out of view. */
.credits-curtain{position:absolute;z-index:2;top:0;bottom:0;width:52%;background:repeating-linear-gradient(90deg,#260817 0%,#651332 7%,#9b2851 13%,#4b102b 20%,#771b42 27%,#300b20 34%);box-shadow:inset 0 0 55px #12000b,0 0 45px #000b}
.credits-curtain:after{content:"";position:absolute;top:0;bottom:0;width:12px;background:linear-gradient(90deg,#6d451d,#f4d58b,#8b5d2a);box-shadow:0 0 22px #f4d58b99}
.credits-curtain-left{left:0;border-right:2px solid #f4d58b;transform-origin:left center;animation:curtainLeft 1.65s cubic-bezier(.72,0,.2,1) both}
.credits-curtain-left:after{right:0}
.credits-curtain-right{right:0;border-left:2px solid #f4d58b;transform-origin:right center;animation:curtainRight 1.65s cubic-bezier(.72,0,.2,1) both}
.credits-curtain-right:after{left:0}
@keyframes curtainLeft{0%{transform:translateX(0)}65%{transform:translateX(-72%)}100%{transform:translateX(-105%)}}
@keyframes curtainRight{0%{transform:translateX(0)}65%{transform:translateX(72%)}100%{transform:translateX(105%)}}
.credits-stage{position:relative;z-index:3;width:min(570px,100%);max-height:calc(100dvh - 20px);overflow:hidden;text-align:center;padding:18px clamp(14px,4vw,34px) 15px;border:1px solid #d7b56caa;border-radius:24px;background:linear-gradient(155deg,#21182ef5,#15121ff8 65%,#26152af5);color:#fff5e6;box-shadow:0 0 0 5px #d4ad5530,0 25px 90px #000b,0 0 45px #e4bd6940;animation:creditsRise .85s .35s both}
@keyframes creditsRise{from{opacity:0;transform:translateY(35px) scale(.96)}to{opacity:1;transform:none}}
.credits-close{position:absolute;top:10px;left:10px;z-index:4;width:34px;height:34px;border:1px solid #ffffff35;border-radius:50%;background:#ffffff12;color:#fff;font-size:24px;line-height:1;cursor:pointer}
