:root {
  --cyan:#8beaf0;
  --cyan-deep:#37cbd8;
  --pink:#ffb7d5;
  --pink-deep:#f28ab9;
  --purple:#bca8f5;
  --ink:#46405d;
  --muted:#9691aa;
  --paper:#fff;
  --line:#eeeaf7
}
* {
  box-sizing:border-box
}
body {
  margin:0;
  min-height:100vh;
  font-family:Tahoma, Arial, sans-serif;
  color:var(--ink);
  background:radial-gradient(circle at 10% 10%,#e2fbfc 0,transparent 30%),radial-gradient(circle at 90% 90%,#ffe5f1 0,transparent 32%),#f8f6ff
}
button,input {
  font:inherit
}
.hidden {
  display:none!important
}
.app-shell {
  min-height:100vh;
  display:grid;
  place-items:center;
  padding:24px
}
.login-view {
  position:relative;
  width:min(100%,470px)
}
.login-card {
  position:relative;
  z-index:1;
  background:#ffffffdc;
  backdrop-filter:blur(18px);
  border:1px solid #fff;
  border-radius:30px;
  padding:38px 42px 28px;
  box-shadow:0 24px 70px #7866a51c;
  text-align:center
}
.logo-bubble {
  width:66px;
  height:66px;
  border-radius:23px;
  margin:0 auto 12px;
  display:grid;
  place-items:center;
  font-size:34px;
  color:#fff;
  background:linear-gradient(135deg,var(--cyan-deep),var(--purple),var(--pink-deep));
  box-shadow:0 10px 25px #bca8f55c
}
.eyebrow {
  color:var(--muted);
  font-size:13px;
  margin:0
}
.login-card h1 {
  font-size:34px;
  letter-spacing:-1px;
  margin:0;
  font-weight:800;
  direction:ltr
}
.login-card h1 span {
  background:linear-gradient(90deg,var(--cyan-deep),var(--pink-deep),var(--purple));
  background-clip:text;
  color:transparent
}
.subtext {
  color:var(--muted);
  font-size:13px;
  margin:4px 0 26px
}
form {
  text-align:right
}
.login-card label {
  display:block;
  font-size:13px;
  font-weight:700;
  margin:14px 2px 7px
}
.input-wrap {
  display:flex;
  align-items:center;
  gap:10px;
  background:#faf9ff;
  border:1px solid var(--line);
  border-radius:14px;
  padding:0 14px;
  height:49px;
  color:#b59eea
}
.input-wrap:focus-within {
  border-color:#a8eaf0;
  box-shadow:0 0 0 3px #8beaf026
}
.input-wrap input {
  border:0;
  outline:0;
  background:transparent;
  width:100%;
  color:var(--ink);
  direction:ltr;
  text-align:left;
  font-size:13px
}
.primary-btn {
  margin-top:23px;
  width:100%;
  border:0;
  border-radius:15px;
  padding:13px;
  color:#fff;
  font-weight:700;
  cursor:pointer;
  background:linear-gradient(100deg,#55d3df,#b29bed 58%,#f3a3c6);
  box-shadow:0 10px 22px #bca8f54d;
  transition:.2s
}
.primary-btn:hover {
  transform:translateY(-2px);
  filter:saturate(1.1)
}
.primary-btn span {
  margin-right:8px
}
.error {
  min-height:18px;
  color:#d75d8d;
  font-size:12px;
  text-align:center;
  margin:8px 0 0
}
.members {
  display:flex;
  justify-content:center;
  gap:8px;
  flex-wrap:wrap;
  margin-top:20px
}
.members span {
  font-size:11px;
  background:#f8f5ff;
  border:1px solid var(--line);
  padding:5px 10px;
  border-radius:20px
}
.floating {
  position:absolute;
  color:#c5b3f5;
  font-size:28px
}
.f1 {
  top:2%;
  left:-8%
}
.f2 {
  right:-7%;
  top:25%;
  color:#f5a9cc
}
.f3 {
  bottom:4%;
  left:1%;
  color:#7adce5
}
.chat-view {
  width:min(1120px,100%);
  height:min(760px,calc(100vh - 48px));
  min-height:560px;
  display:grid;
  grid-template-columns:310px 1fr;
  background:#ffffffed;
  border:1px solid #fff;
  border-radius:28px;
  overflow:hidden;
  box-shadow:0 24px 70px #7866a51c;
  direction:ltr
}
.sidebar {
  background:linear-gradient(165deg,#f2fdff,#fbf7ff 65%,#fff2f8);
  padding:24px 18px;
  display:flex;
  flex-direction:column;
  border-right:1px solid var(--line);
  direction:rtl
}
.side-header {
  display:flex;
  align-items:center;
  justify-content:space-between
}
.mini-brand {
  font-weight:800;
  font-size:20px;
  direction:ltr;
  text-align:right
}
.mini-brand b {
  background:linear-gradient(90deg,var(--cyan-deep),var(--pink-deep));
  background-clip:text;
  color:transparent
}
.side-header small,.me-card small {
  display:block;
  color:var(--muted);
  font-size:11px
}
.icon-btn {
  border:0;
  background:#fff;
  border-radius:12px;
  width:38px;
  height:38px;
  color:#9c8bd0;
  font-size:20px;
  cursor:pointer;
  box-shadow:0 4px 12px #8e80b21a
}
.me-card {
  display:flex;
  align-items:center;
  gap:11px;
  background:#fff;
  border:1px solid #f0edf8;
  border-radius:17px;
  padding:12px;
  margin:27px 0 25px;
  box-shadow:0 8px 20px #8e80b20b
}
.me-card strong {
  font-size:13px
}
.avatar {
  width:42px;
  height:42px;
  flex:none;
  border-radius:15px;
  display:grid;
  place-items:center;
  font-size:20px;
  color:#fff
}
.avatar.cyan {
  background:linear-gradient(135deg,#64d9e2,#a4eff0)
}
.avatar.pink {
  background:linear-gradient(135deg,#f49ac3,#c2a8f4)
}
.avatar.purple {
  background:linear-gradient(135deg,#a997ec,#e0b3ed)
}
.online-dot {
  display:inline-block;
  width:7px;
  height:7px;
  border-radius:50%;
  background:#69d5a6;
  margin-left:5px
}
.me-card .online-dot {
  margin-right:auto
}
.section-label {
  font-size:12px;
  font-weight:800;
  margin:0 5px 12px
}
.section-label span {
  color:#e99abe;
  margin-right:4px
}
.contacts {
  display:grid;
  gap:8px
}
.contact {
  display:flex;
  align-items:center;
  gap:11px;
  padding:10px;
  border-radius:15px;
  border:1px solid transparent;
  background:transparent;
  text-align:right;
  cursor:pointer;
  color:var(--ink);
  transition:.2s
}
.contact:hover,.contact.selected {
  background:#fff;
  border-color:#f0edf8;
  box-shadow:0 6px 18px #8e80b20d
}
.contact strong {
  font-size:13px;
  display:block
}
.contact small {
  font-size:10px;
  color:var(--muted)
}
.contact .avatar {
  width:39px;
  height:39px;
  border-radius:13px
}
.side-footer {
  margin-top:auto;
  text-align:center;
  color:#aaa3ba;
  font-size:10px
}
.side-footer span {
  color:#f19abd
}
.conversation {
  direction:rtl;
  position:relative;
  background:linear-gradient(180deg,#fff,#fcfbff);
  min-width:0
}
.empty-state {
  height:100%;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:24px
}
.empty-art {
  font-size:68px;
  filter:drop-shadow(0 10px 15px #9be5ec80);
  animation:float 3s ease-in-out infinite
}
.empty-state h2 {
  font-size:21px;
  margin:12px 0 4px
}
.empty-state p {
  color:var(--muted);
  font-size:13px;
  margin:0
}
.sparkles {
  color:#d6a4d2;
  margin-top:22px;
  letter-spacing:7px
}
@keyframes float {
  50% {
    transform:translateY(-9px) rotate(5deg)
  }
}
.active-chat {
  height:100%;
  display:flex;
  flex-direction:column
}
.chat-header {
  height:78px;
  display:flex;
  align-items:center;
  gap:12px;
  padding:0 24px;
  border-bottom:1px solid var(--line);
  background:#ffffffd9
}
.chat-person strong {
  font-size:14px
}
.chat-person small {
  display:block;
  color:var(--muted);
  font-size:10px
}
.header-deco {
  margin-right:auto;
  color:#d6b4ec;
  font-size:22px
}
.messages {
  flex:1;
  overflow-y:auto;
  padding:24px;
  display:flex;
  flex-direction:column;
  gap:12px;
  background-image:radial-gradient(#e8e1f533 1px,transparent 1px);
  background-size:18px 18px
}
.message {
  max-width:min(75%,480px);
  padding:10px 14px 7px;
  border-radius:18px;
  box-shadow:0 5px 15px #81749c0c;
  overflow-wrap:anywhere
}
.message.mine {
  align-self:flex-start;
  background:linear-gradient(135deg,#d9fbfc,#e8faff);
  border-bottom-right-radius:5px
}
.message.theirs {
  align-self:flex-end;
  background:linear-gradient(135deg,#ffe3ef,#f4eaff);
  border-bottom-left-radius:5px
}
.message p {
  margin:0;
  font-size:13px;
  white-space:pre-wrap
}
.message time {
  display:block;
  text-align:left;
  color:#9991aa;
  font-size:9px;
  margin-top:3px;
  direction:ltr
}
.composer {
  display:flex;
  gap:10px;
  align-items:center;
  padding:13px 20px 5px;
  border-top:1px solid var(--line)
}
.composer input {
  flex:1;
  min-width:0;
  border:1px solid var(--line);
  outline:0;
  background:#faf9ff;
  border-radius:15px;
  padding:12px 15px;
  font-size:13px
}
.composer input:focus {
  border-color:#9ce6eb
}
.send-btn {
  border:0;
  width:44px;
  height:44px;
  border-radius:15px;
  background:linear-gradient(135deg,#60d5df,#b39aef,#f3a0c6);
  color:white;
  font-size:19px;
  cursor:pointer
}
.composer-note {
  text-align:center;
  color:#b2aabe;
  font-size:9px;
  margin:0 0 8px
}
.contact{position:relative;padding-left:36px}
.unread-badge{position:absolute;top:5px;right:7px;min-width:22px;height:22px;padding:0 6px;border:2px solid var(--panel,#171526);border-radius:999px;display:grid;place-items:center;background:linear-gradient(135deg,#ff5364,#e11d48);color:#fff;font:800 10px/1 Tahoma,Arial,sans-serif;box-shadow:0 3px 10px #e11d4866;z-index:3;pointer-events:none}
@media(max-width:700px){.contact{padding-left:2px}.unread-badge{top:3px;right:5px;min-width:20px;height:20px;font-size:9px}}
@media(max-width:700px) {
  .app-shell {
    padding:0
  }
  .chat-view {
    height:100dvh;
    min-height:0;
    border-radius:0;
    grid-template-columns:105px 1fr
  }
  .sidebar {
    padding:17px 8px
  }
  .side-header {
    display:block;
    text-align:center
  }
  .mini-brand {
    font-size:14px;
    justify-content:center;
    text-align:center
  }
  .side-header small {
    display:none
  }
  .icon-btn {
    margin-top:8px
  }
  .me-card {
    padding:8px 4px;
    justify-content:center;
    flex-wrap:wrap;
    margin:15px 0
  }
  .me-card>div:nth-child(2) {
    width:100%;
    text-align:center
  }
  .me-card .online-dot {
    display:none
  }
  .me-card strong {
    font-size:11px
  }
  .me-card small {
    font-size:9px
  }
  .avatar {
    width:34px;
    height:34px;
    font-size:16px
  }
  .section-label {
    text-align:center;
    font-size:10px
  }
  .contact {
    padding:8px 2px;
    justify-content:center;
    flex-wrap:wrap;
    gap:4px
  }
  .contact>div:nth-child(2) {
    width:100%;
    text-align:center
  }
  .contact strong {
    font-size:10px
  }
  .contact small {
    display:none
  }
  .contact .avatar {
    width:34px;
    height:34px
  }
  .side-footer {
    font-size:8px
  }
  .chat-header {
    height:68px;
    padding:0 12px
  }
  .messages {
    padding:15px 10px
  }
  .message {
    max-width:88%
  }
  .composer {
    padding:10px 9px 4px
  }
  .composer input {
    padding:11px 10px;
    font-size:12px
  }
  .send-btn {
    width:40px;
    height:40px
  }
  .empty-state h2 {
    font-size:17px
  }
  .empty-state p {
    font-size:11px
  }
  .login-card {
    margin:15px;
    padding:30px 23px
  }
}
html, body {
  width: 100%;
  max-width: 100%;
  min-height: 100%;
  overflow-x: clip;
}
body {
  min-width: 0;
}
.app-shell {
  width: 100%;
  max-width: 100vw;
  min-width: 0;
  overflow-x: clip;
}
.chat-view {
  width: min(1120px, 100%);
  max-width: 100%;
  min-width: 0;
  grid-template-columns:  minmax(0, 310px) minmax(0, 1fr);
}
.sidebar, .conversation, .active-chat, .messages, .chat-header, .composer, .login-view, .login-card {
  min-width: 0;
  max-width: 100%;
}
.composer input {
  min-width: 0;
}
.message {
  min-width: 0;
  overflow-wrap: anywhere;
  word-break: break-word;
}
@media (max-width: 760px) {
  .app-shell {
    padding: 0;
  }
  .chat-view {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    min-height: 0;
    border-radius: 0;
    grid-template-columns:  minmax(76px, 88px) minmax(0, 1fr);
    overflow: hidden;
  }
  .sidebar {
    padding: 14px 6px;
    overflow-y: auto;
    overflow-x: hidden;
  }
  .side-header {
    display: flex;
    flex-direction: column;
    gap: 7px;
    text-align: center;
  }
  .mini-brand {
    font-size: 12px;
    text-align: center;
    white-space: normal;
  }
  .side-header small {
    display: none;
  }
  .icon-btn {
    margin: 0;
    width: 34px;
    height: 34px;
  }
  .me-card {
    margin: 12px 0 16px;
    padding: 8px 3px;
    justify-content: center;
    flex-wrap: wrap;
    gap: 5px;
  }
  .me-card > div:nth-child(2) {
    width: 100%;
    text-align: center;
  }
  .me-card .online-dot {
    display: none;
  }
  .me-card strong {
    font-size: 10px;
    overflow-wrap: anywhere;
  }
  .me-card small {
    font-size: 9px;
  }
  .avatar {
    width: 32px;
    height: 32px;
    font-size: 15px;
  }
  .section-label {
    text-align: center;
    font-size: 10px;
    margin: 0 0 8px;
  }
  .contact {
    padding: 7px 2px;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px;
  }
  .contact > div:nth-child(2) {
    width: 100%;
    text-align: center;
  }
  .contact strong {
    font-size: 9px;
    overflow-wrap: anywhere;
  }
  .contact small {
    display: none;
  }
  .contact .avatar {
    width: 31px;
    height: 31px;
  }
  .side-footer {
    font-size: 7px;
  }
  .conversation {
    width: 100%;
    overflow: hidden;
  }
  .chat-header {
    height: 64px;
    flex: 0 0 64px;
    padding: 0 10px;
    gap: 8px;
  }
  .chat-person strong {
    font-size: 12px;
  }
  .messages {
    min-height: 0;
    padding: 12px 9px;
    overflow-x: hidden;
  }
  .message {
    max-width: 90%;
    padding: 9px 11px 6px;
  }
  .message p {
    font-size: 12px;
  }
  .composer {
    flex: 0 0 auto;
    padding: 9px 8px 4px;
    gap: 7px;
  }
  .composer input {
    width: 0;
    flex: 1 1 0;
    min-width: 0;
    padding: 10px 9px;
    font-size: 12px;
  }
  .send-btn {
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
  }
  .composer-note {
    margin-bottom: 6px;
  }
  .empty-state {
    padding: 14px 8px;
  }
  .empty-art {
    font-size: 48px;
  }
  .empty-state h2 {
    font-size: 15px;
  }
  .empty-state p {
    font-size: 10px;
  }
}
@media (max-width: 360px) {
  .chat-view {
    grid-template-columns: 72px minmax(0, 1fr);
  }
  .sidebar {
    padding-inline: 4px;
  }
  .mini-brand {
    font-size: 10px;
  }
  .chat-header {
    padding-inline: 7px;
  }
  .header-deco {
    font-size: 18px;
  }
}
html,body {
  width:100%;
  height:100%;
  min-height:0;
  overflow:hidden
}
body {
  min-width:0
}
.app-shell {
  width:100%;
  height:100dvh;
  min-height:0;
  padding:0;
  overflow:hidden
}
.chat-view {
  width:100%;
  height:100%;
  min-height:0;
  max-width:none;
  border-radius:0;
  grid-template-columns:minmax(220px,280px) minmax(0,1fr)
}
.sidebar {
  min-height:0;
  overflow:auto
}
.contacts {
  overflow:auto
}
.conversation {
  min-height:0;
  display:flex;
  flex-direction:column;
  overflow:hidden
}
.active-chat {
  min-height:0;
  overflow:hidden
}
.messages {
  min-height:0;
  overscroll-behavior:contain
}
.profile-trigger {
  width:100%;
  text-align:right;
  cursor:pointer;
  font-family:inherit;
  color:var(--ink)
}
.avatar {
  background:var(--user-color,linear-gradient(135deg,#64d9e2,#a4eff0));
  overflow:hidden
}
.avatar img,.sticker-image {
  width:100%;
  height:100%;
  object-fit:cover;
  border-radius:inherit
}
.avatar img {
  display:block
}
.group-avatar {
  width:40px;
  height:40px;
  flex:none;
  border-radius:14px;
  display:grid;
  place-items:center;
  color:#fff;
  font-size:21px;
  background:linear-gradient(135deg,#8ddde5,#bd9fe9,#f2a4c7);
  position:relative
}
.group-avatar small {
  position:absolute;
  bottom:-4px;
  right:-4px;
  border:2px solid white;
  background:#a78be8;
  color:#fff;
  border-radius:20px;
  font:9px Tahoma,Arial,sans-serif;
  padding:0 4px
}
.group-avatar.large {
  width:42px;
  height:42px
}
.chat-header {
  flex:0 0 76px
}
.soft-btn,.tool-btn {
  border:1px solid var(--line);
  background:#fff;
  color:#8e7eb8;
  border-radius:12px;
  padding:8px 11px;
  cursor:pointer;
  font-size:12px
}
.header-deco {
  margin-right:auto
}
.pinned-bar {
  padding:8px 16px;
  background:#fff8e8;
  border-bottom:1px solid #f5e6bd;
  color:#9b7a37;
  font-size:11px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis
}
.message {
  position:relative;
  padding-bottom:8px
}
.sender-name {
  font-size:10px;
  font-weight:800;
  display:block;
  margin-bottom:3px
}
.message-meta {
  display:flex;
  gap:7px;
  align-items:center;
  justify-content:flex-end;
  color:#9991aa;
  font-size:9px
}
.message-meta time {
  direction:ltr
}
.message-tools {
  display:flex;
  gap:4px;
  justify-content:flex-start;
  margin-top:5px;
  opacity:.7
}
.message-tools button,.reaction-picker button,.reaction-chip {
  border:0;
  border-radius:9px;
  background:#ffffffb8;
  color:#81759d;
  padding:3px 7px;
  font-size:12px;
  cursor:pointer
}
.message-tools button:hover,.reaction-picker button:hover,.reaction-chip:hover {
  background:#fff;
  transform:translateY(-1px)
}
.reaction-picker {
  display:flex;
  gap:3px;
  flex-wrap:wrap;
  margin-top:5px
}
.reaction-list {
  display:flex;
  gap:4px;
  flex-wrap:wrap;
  margin-top:5px
}
.reaction-chip {
  font-size:11px
}
.reply-quote {
  border-right:3px solid #bd9fe9;
  background:#ffffff8c;
  padding:5px 8px;
  border-radius:7px;
  margin-bottom:7px;
  display:flex;
  flex-direction:column;
  font-size:10px;
  gap:2px
}
.reply-quote span {
  opacity:.8
}
.pin-mark {
  font-size:9px;
  color:#a27d36;
  margin-bottom:4px
}
.reply-preview {
